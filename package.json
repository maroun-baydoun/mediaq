{
  "name": "mediaq",
  "version": "2.0.0",
  "description": "Listen to media query updates in JavaScript",
  "main": "dist/mediaq.js",
  "types": "dist/mediaq.d.ts",
  "type": "module",
  "files": [
    "dist/mediaq.js",
    "dist/mediaq.d.ts",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "test": "npm run build && playwright test",
    "build:clean": "rimraf dist types",
    "build:js": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist --project tsconfig.json",
    "build": "npm run build:clean && npm run build:js && npm run build:types",
    "serve:test": "npx http-server . -p 4173 -a 127.0.0.1 -c-1",
    "format": "prettier --write './{src,test}/**/*.{ts,js,mjs,html}' './playwright.config.ts' './rollup.config.mjs'",
    "preversion": "npm test",
    "version": "npm run build",
    "postversion": "git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maroun-baydoun/mediaq.git"
  },
  "keywords": [
    "mediaquery",
    "responsive",
    "javascript"
  ],
  "author": {
    "name": "Maroun Baydoun",
    "url": "https://maroun-baydoun.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/maroun-baydoun/mediaq/issues"
  },
  "homepage": "https://dev.maroun-baydoun.com/mediaq/",
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "http-server": "14.1.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "rollup": "4.62.4",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  }
}
